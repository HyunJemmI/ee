# Copy this file to .env and enter the values issued by the ChatT administrator.
CHATT_API_KEY=
CHATT_BASE_URL=https://chat.example.com
CHATT_MODEL=ChatT-VIBE

# Start conservatively. Raise concurrency to 8 only after confirming the
# service's simultaneous-request limit and observing stable runs at 4.
CHATT_MAX_CONCURRENCY=4
CHATT_REQUESTS_PER_MINUTE=60
